# Server Configuration
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Auth Configuration
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="your_64_char_random_hex_secret_here"

# PostgreSQL / Neon Database Connection String
# Example: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Flutterwave Webhook Secret Hash
# Must match the Secret Hash configured in your Flutterwave Dashboard -> Settings -> Webhooks
FLW_SECRET_HASH="your_strong_random_flutterwave_secret_hash"

# ==============================================================
# Email Sending & Receiving (Resend — recommended for Render)
# ==============================================================
# 1. Create a free API key at https://resend.com/api-keys
# 2. Before verifying a custom domain, leave MAIL_FROM as "SkillNet <onboarding@resend.dev>"
#    (Resend delivers sandbox emails to your Resend account email, and full emails always print in terminal).
# 3. After verifying your domain on Resend, set MAIL_FROM="SkillNet <no-reply@yourdomain.com>"
RESEND_API_KEY="re_your_resend_api_key"
MAIL_FROM="SkillNet <onboarding@resend.dev>"
SUPPORT_INBOX_EMAIL="your_personal_inbox@gmail.com"
# Set to "true" to also print emails in backend logs (always enabled in non-production by default)
EMAIL_DEV_LOG="true"

# Resend Inbound Email Webhook Secret (optional — set when configuring Resend Receiving -> Render webhook)
# Webhook URL on Render: https://your-backend.onrender.com/api/webhooks/resend-inbound
RESEND_WEBHOOK_SECRET="whsec_your_resend_inbound_secret"

# Optional SMTP fallback (only used if RESEND_API_KEY is not set)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
