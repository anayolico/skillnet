generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  supabaseId  String   @unique
  email       String   @unique
  firstName   String?
  lastName    String?
  imageUrl    String?
  isOnboarded Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile              Profile?
  listings             Listing[]
  swapRequestsSent     SwapRequest[] @relation("SwapRequestsSent")
  swapRequestsReceived SwapRequest[] @relation("SwapRequestsReceived")
  swapsAsA             Swap[]        @relation("SwapsAsA")
  swapsAsB             Swap[]        @relation("SwapsAsB")

  @@index([supabaseId])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Step 1: Professional Identity
  headline        String?          // e.g. "Senior Software Architect"
  bio             String?          // Professional summary

  // Step 2: Skills Offered & Sought
  skillsOffered   String[]         // Skills the user can teach
  skillsSought    String[]         // Skills the user wants to learn

  // Step 3: Preferences & Availability
  experienceLevel String?          // "beginner", "intermediate", "senior", "executive"
  availability    String?          // "part-time", "full-time", "weekends"
  timezone        String?          // e.g. "Europe/London"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Listing {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String                // e.g. "I will teach you Advanced React Architecture"
  description   String?               // Full deliverables description
  skillsOffered String[]              // Skills this listing offers
  skillsSought  String[]              // Skills wanted in return
  category      String?               // Primary category tag
  sessionFormat String?               // "live_video" | "code_review" | "async"
  timeValue     String?               // "1_hour" | "2_hour" | "5_hour" | "ongoing"
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  swapRequests  SwapRequest[]

  @@index([userId])
  @@index([isActive])
}

model SwapRequest {
  id            String   @id @default(cuid())
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requesterId   String
  requester     User     @relation("SwapRequestsSent", fields: [requesterId], references: [id])
  recipientId   String
  recipient     User     @relation("SwapRequestsReceived", fields: [recipientId], references: [id])

  message       String?               // Optional intro message
  status        String   @default("pending")  // "pending" | "accepted" | "declined" | "cancelled"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  swap          Swap?

  @@index([requesterId])
  @@index([recipientId])
  @@index([listingId])
}

model Swap {
  id                String       @id @default(cuid())
  swapRequestId     String       @unique
  swapRequest       SwapRequest  @relation(fields: [swapRequestId], references: [id])

  participantAId    String
  participantA      User         @relation("SwapsAsA", fields: [participantAId], references: [id])
  participantBId    String
  participantB      User         @relation("SwapsAsB", fields: [participantBId], references: [id])

  status            String   @default("active")  // "active" | "completed" | "cancelled"
  milestoneCount    Int      @default(2)
  milestonesCompleted Int    @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([participantAId])
  @@index([participantBId])
}
