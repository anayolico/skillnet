generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(cuid())
  email                String?       @unique
  firstName            String?
  lastName             String?
  imageUrl             String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  isOnboarded          Boolean       @default(false)
  emailVerified        DateTime?
  image                String?
  name                 String?
  password             String?
  subscriptionTier     String        @default("essential")
  accounts             Account[]
  listings             Listing[]
  profile              Profile?
  sessions             Session[]
  swapsAsA             Swap[]        @relation("SwapsAsA")
  swapsAsB             Swap[]        @relation("SwapsAsB")
  swapRequestsReceived SwapRequest[] @relation("SwapRequestsReceived")
  swapRequestsSent     SwapRequest[] @relation("SwapRequestsSent")

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  headline        String?
  bio             String?
  skillsOffered   String[]
  skillsSought    String[]
  experienceLevel String?
  availability    String?
  timezone        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Listing {
  id            String        @id @default(cuid())
  userId        String
  title         String
  description   String?
  skillsOffered String[]
  skillsSought  String[]
  category      String?
  sessionFormat String?
  timeValue     String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  swapRequests  SwapRequest[]

  @@index([userId])
  @@index([isActive])
}

model SwapRequest {
  id          String   @id @default(cuid())
  listingId   String
  requesterId String
  recipientId String
  message     String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isViewed    Boolean  @default(false)
  swap        Swap?
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  recipient   User     @relation("SwapRequestsReceived", fields: [recipientId], references: [id])
  requester   User     @relation("SwapRequestsSent", fields: [requesterId], references: [id])

  @@index([requesterId])
  @@index([recipientId])
  @@index([listingId])
}

model Swap {
  id                  String      @id @default(cuid())
  swapRequestId       String      @unique
  participantAId      String
  participantBId      String
  status              String      @default("active")
  milestoneCount      Int         @default(2)
  milestonesCompleted Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  messages            Message[]
  participantA        User        @relation("SwapsAsA", fields: [participantAId], references: [id])
  participantB        User        @relation("SwapsAsB", fields: [participantBId], references: [id])
  swapRequest         SwapRequest @relation(fields: [swapRequestId], references: [id])

  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id        String   @id @default(cuid())
  swapId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
  swap      Swap     @relation(fields: [swapId], references: [id], onDelete: Cascade)

  @@index([swapId])
}
